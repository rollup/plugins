// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`inject cjs shim for esm output 1`] = `
"
// -- Shims --
import cjsUrl from 'node:url';
import cjsPath from 'node:path';
import cjsModule from 'node:module';
const __filename = cjsUrl.fileURLToPath(import.meta.url);
const __dirname = cjsPath.dirname(__filename);
const require = cjsModule.createRequire(import.meta.url);
const child = require('child');

export { child };
"
`;

exports[`inject cjs shim for esm output with a single import statement 1`] = `
"import MagicString from 'magic-string';


// -- Shims --
import cjsUrl from 'node:url';
import cjsPath from 'node:path';
import cjsModule from 'node:module';
const __filename = cjsUrl.fileURLToPath(import.meta.url);
const __dirname = cjsPath.dirname(__filename);
const require = cjsModule.createRequire(import.meta.url);
const child = require('child');

const s = new MagicString('');

export { child, s };
"
`;

exports[`inject cjs shim for esm output with multiple import statements 1`] = `
"import { constants } from 'node:crypto';
import MagicString from 'magic-string';


// -- Shims --
import cjsUrl from 'node:url';
import cjsPath from 'node:path';
import cjsModule from 'node:module';
const __filename = cjsUrl.fileURLToPath(import.meta.url);
const __dirname = cjsPath.dirname(__filename);
const require = cjsModule.createRequire(import.meta.url);
const child = require('child');

const s = new MagicString('');
const c = constants.SEP;

export { c, child, s };
"
`;

exports[`inject cjs shim for esm output with sourcemap 1`] = `
"
// -- Shims --
import cjsUrl from 'node:url';
import cjsPath from 'node:path';
import cjsModule from 'node:module';
const __filename = cjsUrl.fileURLToPath(import.meta.url);
const __dirname = cjsPath.dirname(__filename);
const require = cjsModule.createRequire(import.meta.url);
const child = require('child');

export { child };
"
`;

exports[`inject cjs shim should not break on valid js object with \`import\` literal value 1`] = `
"
// -- Shims --
import cjsUrl from 'node:url';
import cjsPath from 'node:path';
import cjsModule from 'node:module';
const __filename = cjsUrl.fileURLToPath(import.meta.url);
const __dirname = cjsPath.dirname(__filename);
const require = cjsModule.createRequire(import.meta.url);
const dn = __dirname;

module.exports = {
  keyword: ' import',
  dn
};
"
`;

exports[`not inject cjs shim for cjs output 1`] = `
"'use strict';

const child = require('child');

exports.child = child;
"
`;
